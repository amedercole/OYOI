{
  "name": "oyoi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "brain:init": "gbrain init --pglite --path ./brain --no-embedding --non-interactive --no-git --force",
    "brain:import": "bash -c 'for f in brain-seed/**/*.md; do slug=${f#brain-seed/}; slug=${slug%.md}; gbrain put \"$slug\" --force < \"$f\"; done'",
    "brain:doctor": "gbrain doctor --fast",
    "demo:reset": "bash scripts/reset-demo.sh"
  },
  "dependencies": {
