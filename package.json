    "better-sqlite3": "^13.0.3",
    "next": "16.3.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "twilio": "^6.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
