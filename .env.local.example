# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# Public URL for Twilio webhook + browser agent (ngrok / cloudflared)
PUBLIC_BASE_URL=http://localhost:3000

# LLM (optional — heuristics work without keys for the demo script)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email (Resend preferred; or Gmail SMTP)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
DEMO_EMAIL_TO=
SMTP_USER=
SMTP_PASS=

# Browser Use Cloud (optional — mocks checkout without a key)
BROWSER_USE_API_KEY=

# Optional override if gbrain isn't on PATH
# GBRAIN_BIN=/Users/you/.bun/bin/gbrain
